# writes font_data.cpp and image_data.cpp from the files in assets/, so the ui never parses font or image files from disk at runtime
# rerun after changing one: cmake -P ui/resources/embed_resources.cmake
set(root ${CMAKE_CURRENT_LIST_DIR}/../..)
set(fonts
    poppins_regular=assets/Poppins-Regular.ttf
    poppins_bold=assets/Poppins-Bold.ttf
)
set(images
    test=assets/images/test.png
)

# embed(<output file> <namespace> <name=path>...): each file becomes `namespace::name[]` and `namespace::name_size`, declared in ui.h
function(embed output namespace)
    set(out "// generated by ui/resources/embed_resources.cmake from assets/, don't edit by hand\n\n#include \"../ui.h\"\n")
    foreach(entry ${ARGN})
        string(REPLACE "=" ";" entry ${entry})
        list(GET entry 0 name)
        list(GET entry 1 path)

        file(READ ${root}/${path} hex HEX)
        string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n    " bytes "${bytes}")
        string(STRIP "${bytes}" bytes)

        # qualified definitions of the declarations in ui.h, which give them external linkage
        string(APPEND out "\n// ${path}\nconst unsigned char ${namespace}::${name}[] = {\n    ${bytes}\n};\nconst int ${namespace}::${name}_size = sizeof(${namespace}::${name});\n")
    endforeach()
    file(WRITE ${CMAKE_CURRENT_LIST_DIR}/${output} "${out}")
endfunction()

embed(font_data.cpp celosia::resources::font_data ${fonts})
embed(image_data.cpp celosia::resources::image_data ${images})
