{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "vs2022",
            "displayName": "Visual Studio 2022 (x64, Win32 + D3D11)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/vs2022",
            "cacheVariables": { "CELOSUI_PLATFORM": "win32" },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        }
    ],
    "buildPresets": [
        { "name": "debug", "displayName": "Debug", "configurePreset": "vs2022", "configuration": "Debug" },
        { "name": "release", "displayName": "Release", "configurePreset": "vs2022", "configuration": "Release" }
    ],
    "testPresets": [
        { "name": "debug", "configurePreset": "vs2022", "configuration": "Debug", "output": { "outputOnFailure": true } },
        { "name": "release", "configurePreset": "vs2022", "configuration": "Release", "output": { "outputOnFailure": true } }
    ]
}
